# Ignore node_modules since dependencies are installed at runtime
node_modules
npm-debug.log
yarn-error.log
pnpm-debug.log

# Ignore local environment files
.env
.env.local
.env.development
.env.test
.env.production

# Ignore build artifacts
dist
build

# Ignore dependency lock files (if using a package manager other than npm)
yarn.lock
pnpm-lock.yaml

# Ignore editor and OS-specific files
.DS_Store
Thumbs.db
.vscode
.idea
*.swp
*.swo

# Ignore logs and temporary files
*.log
*.cache
.tmp
